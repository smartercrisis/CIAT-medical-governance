{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIATPhase2Gate",
  "type": "object",
  "properties": {
    "document_id": { "type": "string" },
    "total_violations": { "type": "integer" },
    "violations_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": { "type": "string" },
          "reference": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string" },
          "flagged_term": { "type": "string" }
        },
        "required": ["rule_id", "reference", "category", "severity", "flagged_term"]
      }
    }
  },
  "required": ["document_id", "total_violations", "violations_matrix"]
}
