{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIATPhase4ClinicalSovereign",
  "type": "object",
  "properties": {
    "document_id": { "type": "string" },
    "practitioner_id": { "type": "string" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "hash_chain": {
      "type": "object",
      "properties": {
        "identity_context_hash": { "type": "string" },
        "source_hierarchy_hash": { "type": "string" },
        "phase1_gate_hash": { "type": "string" },
        "phase2_gate_hash": { "type": "string" },
        "phase3_practitioner_gate_hash": { "type": "string" }
      },
      "required": [
        "identity_context_hash",
        "source_hierarchy_hash",
        "phase1_gate_hash",
        "phase2_gate_hash",
        "phase3_practitioner_gate_hash"
      ]
    },
    "hmac_sha256_signature": { "type": "string" },
    "verification_status": { "type": "string", "enum": ["PASSED", "REJECTED"] }
  },
  "required": [
    "document_id",
    "practitioner_id",
    "timestamp_utc",
    "hash_chain",
    "hmac_sha256_signature",
    "verification_status"
  ]
}
